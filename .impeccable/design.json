    "narrative":  {
                      "northStar":  "克制的矿物绿工作空间",
                      "overview":  "矿物绿面板承载紧凑的原生工具，中央画面是持续可见的工作对象。薄荷色只承担主操作、选中和焦点反馈；界面保持安静，让可编辑的场景内容决定画面的色彩与表现。\n\n系统中文字体、稳定输入宽度和按需展开的属性组，服务连续的布置、验证和输出。物体属性与全局设置用标题和作用范围区分；简短结果反馈留在滚动区外。这里记录的是已实现的 Godot Control 工作台，不约束视频内容中的字体、颜色、荧光或三维光照。",
                      "keyCharacteristics":  [
                                                 "矿物绿平面层次与薄荷色状态反馈。",
                                                 "系统中文字体与紧凑、稳定的原生输入。",
                                                 "中央画面扩展，物体与属性各有固定工作区。",
                                                 "低频选项逐级展开，状态与结果持续可见。"
                                             ],
                      "rules":  [
                                    {
                                        "name":  "The Stable Type Rule",
                                        "body":  "缩小窗口保留原字号与输入尺寸，以自动换行和属性区滚动适配，不整体缩放工作台。",
                                        "section":  "typography"
                                    },
                                    {
                                        "name":  "The Canvas Space Rule",
                                        "body":  "窗口变宽时扩展中央工作画面，保持两侧工具的稳定密度；窗口变矮时让属性内容滚动。",
                                        "section":  "layout"
                                    },
                                    {
                                        "name":  "The Flat Workbench Rule",
                                        "body":  "用色面和状态组织原生工作台；不要将视频中的光照与特效用作工具面板装饰。",
                                        "section":  "elevation"
                                    },
                                    {
                                        "name":  "The State Color Rule",
                                        "body":  "界面强调色说明可操作、选中、焦点或结果；场景自身的色彩不进入工作台主题。",
                                        "section":  "colors"
                                    }
                                ],
                      "dos":  [
                                  "Do 复用原生主题的普通、悬停、按下、禁用与焦点状态。",
                                  "Do 保留数值框（88px）与系统字号，让字段换行、属性区滚动。",
                                  "Do 用短标题和上下文说明当前物体或全局设置的作用范围。",
                                  "Do 在滚动区外显示真实运行状态和操作结果，错误同时提供文字说明。",
                                  "Do 将新增低频设置归入可折叠属性组，并遵守维度与继承条件。"
                              ],
                      "donts":  [
                                    "Don\u0027t 把场景预览中的字体、颜色、荧光或三维阴影提升为工作台主题。",
                                    "Don\u0027t 用整体缩小字体与控件适配支持范围内的紧凑窗口。",
                                    "Don\u0027t 为工作面板添加装饰投影或重复浮动卡片层次。",
                                    "Don\u0027t 用普通按钮的颜色替代真实禁用状态，或只用颜色表达错误。",
                                    "Don\u0027t 以文字字符替代几何折叠图标或原生功能图标。"
                                ]
